# =================================================================
# Market Sentiment & News Vector Correlation Platform - Env Config
# =================================================================

# Server Configuration
API_PORT=8000
DASHBOARD_PORT=8501
CORS_ORIGINS=*

# Optional Security API Key for administrative endpoints
API_KEY=your_admin_secret_key_here

# Vector Storage Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Set to 'memory' to use in-memory vector indexing if Qdrant daemon is not running
QDRANT_MODE=memory

# SEC Edgar Ingestion User Agent (Required for SEC 8-K filings extraction)
SEC_EDGAR_USER_AGENT=MarketVectorPlatform/1.0 (contact@marketvector.com)

# Optional Financial Market API Keys
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=
